{
  "name": "hris-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build:web": "npm run build --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:api": "composer test --working-dir=apps/api",
    "test:e2e": "npm run test:e2e --workspace=apps/web",
    "test:regression": "npm run test:api && npm run test --workspaces --if-present && npm run test:e2e"
  },
  "engines": {
    "node": ">=18"
  }
}
